{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBill",
  "version": "1.0.0",
  "identifier": "io.github.vpjigin.openbill",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Offline GST billing for Indian shops",
    "longDescription": "OpenBill \u2014 offline GST billing for Indian shops. The desktop app runs the server; counters and phones bill through the browser over Wi-Fi or a public link.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist-server/": "server/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}
