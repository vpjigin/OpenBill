{
  "name": "billing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:billing": "vite --port 5173",
    "dev:admin": "cross-env VITE_APP=admin vite --port 5174 --open /admin.html",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:responsive": "playwright test e2e/responsive.spec.ts",
    "typecheck": "tsc -b",
    "test:words": "node --experimental-strip-types --test src/shared/words.test.ts",
    "test:barcode": "node --experimental-strip-types --test src/shared/barcode.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4"
  }
}
